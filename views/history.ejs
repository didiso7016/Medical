<%- include('partials/head', { title }) %>
<%- include('partials/person-bar', { person, subtitle: '服藥紀錄' }) %>

<main class="wrap">
  <%# 規格 §7：紀錄一律從目前的家庭成員 context 查詢，不會混入其他人 %>
  <% if (!days.length) { %>
    <div class="card card--spaced">
      <div class="empty">
        <%- icon('history', { size: 34, stroke: 1.4 }) %>
        <p class="empty__title">還沒有<%= person.name %>的服藥紀錄</p>
        <p class="empty__message">在「今日」勾選服藥後，就會記在這裡。</p>
      </div>
    </div>
  <% } else { %>
    <p class="section-label">最近 <%= days.length %> 天</p>
    <% days.forEach(function (day) { %>
      <section class="history-day">
        <div class="history-day__date">
          <span class="history-day__num"><%= formatShortDate(day.date) %></span>
          <span class="history-day__full"><%= formatLongDate(day.date) %></span>
        </div>
        <div class="card">
          <% day.slots.forEach(function (slot) { %>
            <div class="history-slot">
              <div class="history-slot__name"><%= slot.name %></div>
              <% slot.items.forEach(function (item) { %>
                <div class="history-row">
                  <span class="history-row__check"><%- icon('check', { size: 14, stroke: 2.6 }) %></span>
                  <span class="history-row__name"><%= item.label %></span>
                  <span class="history-row__time"><%= hhmm(item.taken_at) %></span>
                </div>
              <% }) %>
            </div>
          <% }) %>
        </div>
      </section>
    <% }) %>
  <% } %>
</main>

<%- include('partials/tabbar', { person, active }) %>
<%- include('partials/foot') %>
