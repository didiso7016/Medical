<%- include('partials/head', { title }) %>
<%- include('partials/person-bar', { person, subtitle: dateLabel, progress }) %>

<main class="wrap">
  <nav class="datebar">
    <a href="/persons/<%= person.id %>/today?date=<%= prevDate %>">
      <%- icon('chevron-left', { size: 17 }) %>前一天
    </a>
    <span class="datebar__spacer"></span>
    <% if (isToday) { %>
      <a class="is-disabled" aria-disabled="true">後一天<%- icon('chevron-right', { size: 17 }) %></a>
    <% } else { %>
      <a href="/persons/<%= person.id %>/today">回到今天<%- icon('chevron-right', { size: 17 }) %></a>
    <% } %>
  </nav>

  <% if (!groups.length) { %>
    <div class="card card--spaced">
      <div class="empty">
        <%- icon('pill', { size: 34, stroke: 1.4 }) %>
        <p class="empty__title"><%= person.name %>還沒有排定的用藥</p>
        <p class="empty__message">先新增藥品並設定服用時段，這裡就會列出來。</p>
      </div>
    </div>
  <% } %>

  <% groups.forEach(function (group) { %>
    <% const done = group.items.filter(i => i.taken_at).length; %>
    <section class="slot-card">
      <header class="slot-card__head">
        <%- icon(SLOT_ICONS[group.slot.code], { size: 17 }) %>
        <h2 class="slot-card__name"><%= group.slot.name %></h2>
        <span class="slot-card__count <%= done >= group.items.length ? 'is-complete' : '' %>"><%= done %>/<%= group.items.length %></span>
      </header>
      <ul class="dose-list">
        <% group.items.forEach(function (item) { %>
          <li>
            <%# 每一列就是一個表單：後端會再驗證這個藥品是否屬於目前這個人 %>
            <form method="post" action="/persons/<%= person.id %>/today/toggle" class="js-toggle">
              <input type="hidden" name="medication_id" value="<%= item.medication_id %>">
              <input type="hidden" name="time_slot_id" value="<%= item.time_slot_id %>">
              <input type="hidden" name="date" value="<%= date %>">
              <button type="submit" class="dose <%= item.taken_at ? 'is-done' : '' %>"
                      aria-pressed="<%= item.taken_at ? 'true' : 'false' %>">
                <span class="dose__box"><%- icon('check', { size: 15, stroke: 3 }) %></span>
                <span class="dose__body">
                  <span class="dose__name"><%= item.label %></span>
                  <% if (doseLine(item)) { %>
                    <span class="dose__meta"><%= doseLine(item) %></span>
                  <% } %>
                </span>
                <span class="dose__time"><%= hhmm(item.taken_at) %></span>
              </button>
            </form>
          </li>
        <% }) %>
      </ul>
    </section>
  <% }) %>

  <div class="btn-row">
    <a class="btn btn--primary" href="/persons/<%= person.id %>/medications/new">
      <%- icon('plus', { size: 18, stroke: 2 }) %>新增藥品
    </a>
    <% if (groups.length) { %>
      <a class="btn" href="/persons/<%= person.id %>/order"><%- icon('sort', { size: 18 }) %>排序</a>
    <% } %>
  </div>
</main>

<%- include('partials/tabbar', { person, active }) %>
<%- include('partials/foot') %>
