<%- include('../partials/head', { title }) %>

<main class="wrap picker">
  <h1 class="picker__title">家庭用藥</h1>
  <p class="picker__sub">請選擇家庭成員</p>

  <div class="person-grid">
    <% persons.forEach(function (p) { %>
      <a class="person-card" href="/persons/<%= p.id %>/today">
        <%- include('../partials/avatar', { p, size: 'lg' }) %>
        <span class="person-card__name"><%= p.name %></span>
        <% if (!p.summary || !p.summary.total) { %>
          <span class="person-card__meta">尚未建立藥品</span>
        <% } else if (p.summary.done >= p.summary.total) { %>
          <span class="person-card__meta is-done">
            <%- icon('check', { size: 13, stroke: 2.6 }) %>今日已完成
          </span>
        <% } else { %>
          <span class="person-card__meta">今日 <%= p.summary.done %> / <%= p.summary.total %></span>
        <% } %>
      </a>
    <% }) %>

    <a class="person-card person-card--add" href="/persons/new">
      <%- icon('user-plus', { size: 26 }) %>
      <span class="person-card__name">新增成員</span>
    </a>
  </div>
</main>

<%- include('../partials/foot') %>
